{
  "name": "nutribro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--use-system-ca next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "NODE_OPTIONS=--use-system-ca node --env-file-if-exists=.env.local .next/standalone/server.js",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "NODE_OPTIONS=--use-system-ca drizzle-kit migrate",
    "db:import-json": "NODE_OPTIONS=--use-system-ca tsx scripts/import-json.ts",
    "db:seed-default-recipes": "NODE_OPTIONS=--use-system-ca tsx scripts/seed-default-recipe-library.ts",
    "db:seed": "NODE_OPTIONS=--use-system-ca tsx scripts/seed.ts",
    "seed": "npm run db:seed",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@neondatabase/serverless": "^1.1.0",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
