# URL de la base Neon exclusiva para desarrollo, usada desde localhost.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Secreto aleatorio de Auth.js. No lo compartas ni lo incluyas en Git.
AUTH_SECRET=replace-with-a-long-random-secret

# Solo para la importación puntual del anterior almacén JSON. El comando exige
# confirmación explícita y que el usuario destino ya haya iniciado sesión.
# NUTRITION_IMPORT_USER_ID=
# NUTRITION_IMPORT_CONFIRM=replace
# NUTRITION_IMPORT_FILE=data/nutrition-data.json
# NUTRITION_IMPORT_SOURCE_OWNER_ID=00000000-0000-4000-8000-000000000001

# Para añadir una vez la biblioteca predeterminada a una cuenta existente.
# NUTRITION_DEFAULT_RECIPES_USER_ID=
# NUTRITION_DEFAULT_RECIPES_USE_SOLE_USER=1
# NUTRITION_DEFAULT_RECIPES_CONFIRM=add
